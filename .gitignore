node_modules
# package.json 的 packageManager 是 pnpm，唯一有效的锁文件是 pnpm-lock.yaml。
# package-lock.json 没有任何使用方（Vercel 和 CI 都跑 pnpm install），
# 历史上删过一次又被恢复过，这里显式忽略防 npm install 误生成后再次入库。
package-lock.json
dist
dist.old
.astro
# Astro 的 env 文件：.env / .env.local / .env.development / .env.preview / .env.production。
# 用 .env.* 通配一次覆盖全，再显式把 .env.example 放回来 —— 它是提交进仓库的模板。
.env
.env.*
!.env.example
.vercel
.netlify
uploads
.backup/
frontend-backup-*/
nul
backend_backup_*/
*.tar.gz
backend/test-*.js
backend/scripts/*.mjs
scripts/*.mjs
!scripts/subset-font.mjs
!scripts/defer-css.mjs
*.db
*.tar
.qoder/
.workbuddy/
.git.backup/
*.md.bak
*.png.bak
backend/.backend.log
*.log.bak
*.log
.wrangler/
_tmp_*
.obsidian/

# public/covers 封面需随仓库发布，否则 EO 静态托管时 404

# 删除文件的临时备份（rename 绕过 safe-delete 用）
.wb-trash/

# 临时测试脚本（点开头或 test- 前缀，勿误提交）
.test*.mjs
.diag*.mjs
test-*.cjs
*.bak-remove
