---
import { footerConfig } from '../../config/footerConfig';
import { siteConfig } from '../../config/siteConfig';

interface Props {
  siteTitle?: string;
  icp?: string;
  footerText?: string;
  siteStartDate?: string;
  footerBadges?: string;
}

const {
  siteTitle = siteConfig.title,
  icp = '',
  footerText = '',
  siteStartDate = '2026-08-30',
  footerBadges = '',
} = Astro.props;

// shields.io 徽章（来自「页脚设置」JSON 字符串）
let badges: { title: string; href: string; img: string }[] = [];
try {
  if (footerBadges) badges = JSON.parse(footerBadges);
} catch {
  badges = [];
}

// 仪表盘技术栈徽标（脚页顶部时钟右侧）
const dashboardBadges = footerConfig.dashboardBadges as Array<{ name: string; color: string }>;

// ICP 备案（仪表盘右侧可点击链接）
const icpConfig = footerConfig.icpConfig;

const year = new Date().getFullYear();
const startYear = siteStartDate ? new Date(siteStartDate).getFullYear() : NaN;
const copyrightRange = !isNaN(startYear) && startYear < year ? `${startYear} - ${year}` : `${year}`;
---

<footer class="site-footer">
  <div id="footer-wrap">

    {/* 仪表盘长条：翻页时钟 + 运行天数 + 技术栈徽标 + ICP */}
    <div id="ft-dash">
      <div id="ft-clock">
        <div class="clock-glow"></div>
        <span id="clock-display">00:00:00</span>
        <div class="clock-split"></div>
      </div>

      <div id="ft-status">
        <div class="ft-uptime">
          <span class="dot"></span>
          <span>系统已稳定运行：<span id="uptime-display">载入中</span></span>
        </div>

        <div class="ft-badges">
          {dashboardBadges.map((b) => (
            <span class="dbadge">
              <span class="d-dot" style={`background:${b.color}`}></span>
              {b.name}
            </span>
          ))}
        </div>

        {icpConfig && (
          <div class="ft-icmp">
            <a href={icpConfig.link} target="_blank" rel="noopener noreferrer">{icpConfig.name}</a>
          </div>
        )}
      </div>
    </div>

    {/* 底部：版权 / 自定义文字 / shields 徽章 */}
    <div id="footer-bottom">
      <div class="copyright">
        <b>&copy;<span id="copyright-year" data-start-year={isNaN(startYear) ? '' : startYear}>{copyrightRange}</span> {siteTitle}</b>
      </div>
      {footerText && <div class="footer_custom_text" set:html={footerText} />}
      {(badges.length > 0 || icp) && (
        <p id="ghbdages">
          {badges.map((b) => (
            <a class="github-badge" target="_blank" href={b.href} title={b.title}>
              <img src={b.img} alt="" loading="lazy" />
            </a>
          ))}
          {icp && (
            <a class="github-badge" target="_blank" href="https://beian.miit.gov.cn/" title="ICP 备案">
              <img src={`https://img.shields.io/badge/ICP-${icp}-60a5fa?style=flat`} alt="" />
            </a>
          )}
        </p>
      )}
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    border-top: 1px solid rgb(var(--card-border));
    background: rgb(var(--bg-soft) / 0.55);
    backdrop-filter: blur(12px) saturate(140%);
    color: rgb(var(--fg-muted));
  }

  #footer-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding: 18px 20px 10px;
    max-width: 1200px;
    margin: 0 auto;
  }

  /* ===== 仪表盘长条 ===== */
  #ft-dash {
    width: 100%;
    display: flex;
    flex-direction: row;
    align-items: stretch;
    border-radius: 16px;
    background: rgb(var(--card-bg) / 0.6);
    backdrop-filter: blur(8px);
    border: 1px solid rgb(var(--card-border));
    box-shadow: 0 10px 30px -16px rgba(0, 0, 0, 0.3);
    overflow: hidden;
    min-height: 76px;
    transition: box-shadow 0.35s ease, border-color 0.35s ease;
  }
  .dark #ft-dash {
    background: rgba(45, 48, 58, 0.6);
  }

  /* 翻页时钟（深色底，始终深色，模拟翻页显示屏） */
  #ft-clock {
    background: var(--color-ink-800);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 30px;
    min-width: 210px;
    position: relative;
    overflow: hidden;
    cursor: default;
    transition: color 0.3s ease;
  }
  #ft-clock:hover {
    color: #818cf8;
  }
  #clock-display {
    font-family: 'SF Mono', 'Menlo', 'Consolas', 'Courier New', monospace;
    font-variant-numeric: tabular-nums;
    font-weight: 900;
    font-size: 1.6rem;
    letter-spacing: 3px;
    color: #ffffff;
    position: relative;
    z-index: 1;
    text-shadow: 0 0 12px rgba(129, 140, 248, 0.25);
  }
  #ft-clock:hover #clock-display {
    color: #a5b4fc;
    text-shadow: 0 0 14px rgba(165, 180, 252, 0.4);
  }
  .clock-split {
    position: absolute;
    left: 12%;
    right: 12%;
    top: 50%;
    height: 1px;
    background: rgba(0, 0, 0, 0.55);
    z-index: 2;
  }
  .clock-glow {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.12), transparent 60%);
    pointer-events: none;
  }

  /* 右侧状态区 */
  #ft-status {
    flex: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 18px;
    padding: 0 22px;
    font-size: 0.85rem;
    color: rgb(var(--fg-soft));
    font-weight: 600;
  }
  .ft-uptime {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .ft-uptime .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 8px #22c55e;
    animation: pulse 1.6s ease-in-out infinite;
    flex-shrink: 0;
  }
  #uptime-display {
    color: #818cf8;
    font-weight: 800;
  }
  .dark #uptime-display {
    color: #a5b4fc;
  }

  .ft-badges {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .dbadge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    background: rgb(var(--card-bg) / 0.6);
    border: 1px solid rgb(var(--card-border));
    border-radius: 6px;
    font-size: 0.78rem;
    font-weight: 700;
    color: rgb(var(--fg-soft));
    transition: border-color 0.25s ease, transform 0.25s ease;
  }
  .dbadge .d-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }
  .dbadge:hover {
    border-color: var(--color-accent-sand);
    transform: translateY(-1px);
  }

  .ft-icmp a {
    color: rgb(var(--fg-soft));
    border-bottom: 1px dashed rgb(var(--fg-muted));
    text-decoration: none;
    font-weight: 700;
    transition: color 0.25s ease;
  }
  .ft-icmp a:hover {
    color: #818cf8;
  }
  .dark .ft-icmp a:hover {
    color: #a5b4fc;
  }

  /* ===== 底部 ===== */
  #footer-bottom {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }
  .copyright {
    font-size: 0.95rem;
    text-align: center;
  }
  .copyright b {
    color: rgb(var(--fg-soft));
  }
  .footer_custom_text {
    font-size: 0.8rem;
    text-align: center;
  }
  #ghbdages {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
    margin: 2px 0 0;
  }
  .github-badge {
    display: inline-block;
  }
  .github-badge img {
    height: 20px;
    width: auto;
    border-radius: 4px;
    transition: transform 0.25s ease;
    vertical-align: middle;
  }
  .github-badge:hover img {
    transform: scale(1.06);
  }

  @keyframes pulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.4); opacity: 0.5; }
  }

  /* ===== 响应式 ===== */
  @media screen and (max-width: 768px) {
    #ft-dash {
      flex-direction: column;
    }
    #ft-clock {
      min-width: 100%;
      padding: 14px 0;
    }
    #clock-display {
      font-size: 1.4rem;
    }
    #ft-status {
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 12px 18px;
      gap: 10px;
    }
  }
  @media screen and (max-width: 576px) {
    #footer-wrap {
      padding: 16px 18px 8px;
      gap: 14px;
    }
    #clock-display {
      font-size: 1.2rem;
      letter-spacing: 2px;
    }
    #ft-clock {
      min-width: 100%;
    }
    .github-badge img {
      max-height: 22px;
    }
  }
</style>

<script is:inline define:vars={{ startDate: siteStartDate, year, startYear }}>
  function pad(n) { return String(n).padStart(2, '0'); }

  function tick() {
    var now = new Date();
    var timeEl = document.getElementById('clock-display');
    if (timeEl) {
      timeEl.textContent = pad(now.getHours()) + ':' + pad(now.getMinutes()) + ':' + pad(now.getSeconds());
    }
    var st = Date.parse(startDate);
    if (!isNaN(st)) {
      var diff = now - st;
      var days = Math.floor(diff / 86400000);
      var hours = Math.floor((diff / 3600000) % 24);
      var up = document.getElementById('uptime-display');
      if (up) up.textContent = days + '天 ' + hours + '小时';
    }
  }

  tick();
  setInterval(tick, 1000);

  function updateCopyrightYear() {
    var el = document.getElementById('copyright-year');
    if (!el) return;
    var sy = parseInt(el.getAttribute('data-start-year') || '', 10);
    var y = new Date().getFullYear();
    el.textContent = (!isNaN(sy) && sy < y) ? (sy + ' - ' + y) : String(y);
  }
  updateCopyrightYear();
  document.addEventListener('astro:page-load', updateCopyrightYear);
</script>
