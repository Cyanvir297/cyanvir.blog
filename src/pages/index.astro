---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/layout/PostCard.astro';
import Sidebar from '../components/widget/Sidebar.astro';
import ImageWrapper from '../components/common/ImageWrapper.astro';
import type { Post } from '../types';
import { getAllPosts, getAllPostsForRoutes, getSiteSettings, getCategories, getTags } from '../utils/data';
import { siteConfig } from '../config/siteConfig';
const settings = getSiteSettings();
const siteTitle = settings.siteTitle;
const siteDescription = settings.siteDescription;
// hero 只支持静态图。早期版本还有视频分支（siteConfig.heroType === 'video' + heroVideo），
// 该键静态化后不存在、分支永不渲染，已删除。要恢复见 git 历史 3d6168b:src/pages/index.astro。
const heroImage = settings.heroImage || 'images/hero.webp';
const siteStartDate = settings.siteStartDate || '';

const categories = await getCategories();
const tags = await getTags();

// hero 社交图标栏：解析 siteConfig.titleIcons（JSON 数组），为空则隐藏
function iconSrc(icon: string): string {
  return /^https?:\/\//i.test(icon) ? icon : `https://cdn.simpleicons.org/${icon}`;
}
let titleIcons: { icon: string; href: string }[] = [];
try {
  const parsed = JSON.parse(siteConfig.titleIcons || '[]');
  if (Array.isArray(parsed)) titleIcons = parsed.filter((it: any) => it && typeof it.icon === 'string');
} catch {}

// hero 打字机文案：取自 siteConfig.heroSentences，客户端洗牌后轮播（无 source 则不显示出处行）
const heroSentences: { main: string; source: string; lines?: string[] }[] = siteConfig.heroSentences
  .filter((s: any) => !!s && typeof s.main === 'string' && s.main.trim() !== '')
  .map((s: any) => ({
    main: s.main as string,
    source: typeof s.source === 'string' ? s.source : '',
    lines: Array.isArray(s.lines) ? s.lines : undefined,
  }));


const posts: Post[] = await getAllPosts();
// 统计口径：包含 hide 隐藏文章（列表不显示但计数保留）
const allPosts: Post[] = await getAllPostsForRoutes();
let error: string | null = null;

// 公开访客统计（纯静态改由 Vercount 客户端填充，构建期传 0）
const visitorStats = { visitors: 0, pageviews: 0 };

// 本站总字数：与文章详情页口径一致（中文按字、英文按词，含代码）
function countWords(md: string): number {
  const chinese = (md || '').match(/[\u4e00-\u9fa5]/g) || [];
  const words = (md || '').match(/[A-Za-z0-9_]+/g) || [];
  return chinese.length + words.length;
}
const postCount = allPosts.length;
const totalWords = allPosts.reduce((sum, p) => sum + countWords(p.content || ''), 0);

// 运行时间：自建站日期至今的天数（未配置建站日期时显示 —）
const runDays = siteStartDate
  ? Math.max(0, Math.floor((Date.now() - new Date(siteStartDate).getTime()) / 86400000))
  : -1;

// 最后更新：以构建时间为基准（客户端再算相对时间）
const lastBuildTs = Date.now();

const latestPosts = posts.slice(0, 6);
---

<BaseLayout wide description={siteTitle + ' — ' + siteDescription}>
  <section class="relative mx-auto max-w-[1200px] overflow-hidden rounded-3xl text-center sm:py-24 px-4">
    <ImageWrapper
      src={heroImage}
      alt=""
      class="absolute inset-0 h-full w-full object-cover"
      fetchpriority="high"
      loading="eager"
      widths={[640, 960, 1220]}
      sizes="(max-width: 1200px) 100vw, 1200px"
      aria-hidden="true"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black/30 via-black/40 to-black/60"></div>
    <div class="relative px-6 py-16">
      <h1 class="neon-text text-3xl sm:text-5xl font-extrabold tracking-tight text-white drop-shadow-lg">
        {siteTitle}
      </h1>
      <p class="mx-auto mt-4 max-w-xl text-center text-base sm:text-lg text-white/85 min-h-[7rem]">
        <!-- 文案经 data-sentences 传入，由 public/scripts/base/hero.js 读取；
             原实现用 define:vars 注进内联脚本，会让 astro check 把整段 JS 当 TS 解析。 -->
        <span id="typewriter-text" class="neon-text" data-sentences={JSON.stringify(heroSentences)}></span><span id="typewriter-cursor" class="ml-1 animate-blink">|</span>
      </p>
      {
        titleIcons.length > 0 && (
          <ul class="mt-5 flex flex-wrap items-center justify-center gap-5">
            {titleIcons.map((it, i) => (
              <li>
                <a
                  href={it.href || '#'}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={it.icon}
                  class="inline-flex h-9 w-9 items-center justify-center transition-transform hover:scale-110"
                >
                  <img src={iconSrc(it.icon)} alt={it.icon} class="h-7 w-7 object-contain" />
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>

  <section class="mx-auto mt-16 max-w-[1200px] px-4">
    <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_26%]">
      <!-- 左栏：最新文章 -->
      <div>
        <div class="mb-8 flex items-end justify-between">
          <div>
            <h2 class="text-2xl font-bold">最新文章</h2>
            <p class="mt-1 text-[rgb(var(--fg-soft))]">看看最近发布了什么</p>
          </div>
          <a href="/posts" class="text-sm font-medium text-[rgb(var(--primary))] hover:brightness-110">
            查看全部 →
          </a>
        </div>

        {
          error ? (
            <div class="rounded-xl border border-red-100 bg-red-50 p-6 text-center text-red-700">
              <p class="font-medium">加载文章失败</p>
              <p class="mt-1 text-sm">{error}</p>
            </div>
          ) : latestPosts.length === 0 ? (
            <div class="rounded-xl border p-12 text-center text-[rgb(var(--fg-soft))]" style="border-color: rgb(var(--border) / 0.4); background: rgb(var(--surface));">
              暂无文章，稍后再来吧
            </div>
          ) : (
            <div class="grid gap-6 sm:grid-cols-2">
              {latestPosts.map((post) => (
                <PostCard post={post} />
              ))}
            </div>
          )
        }
      </div>

      <!-- 右栏：资料 + 分类 + 标签 + 网站信息（桌面端吸顶） -->
      <aside class="lg:sticky lg:top-24 h-fit">
        <Sidebar
          categories={categories}
          tags={tags}
          postCount={postCount}
          totalWords={totalWords}
          runDays={runDays}
          visitorCount={visitorStats.visitors}
          pageViews={visitorStats.pageviews}
          lastUpdated={lastBuildTs}
        />
      </aside>
    </div>
  </section>

<!-- 首页 hero 打字机已挪到 public/scripts/base/hero.js（经 entry.js 按需加载）。
     原实现是内联脚本 + define:vars 注入，会让 astro check 把整段原生 JS 当 TS 解析、
     报出上百个误报。本注释刻意不出现 script 标签的字面写法，否则解析器会误判。 -->

</BaseLayout>
